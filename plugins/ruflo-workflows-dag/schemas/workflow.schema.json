{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ruvnet/ruflo/plugins/ruflo-workflows-dag/schemas/workflow.schema.json",
  "title": "Ruflo Workflow",
  "description": "Declarative DAG workflow definition for ruflo-workflows-dag",
  "type": "object",
  "required": ["name", "nodes"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "provider": { "type": "string", "enum": ["claude", "codex"] },
    "model": { "type": "string" },
    "interactive": { "type": "boolean" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/node" }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z_][\\w-]*$" },
        "description": { "type": "string" },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" }
        },
        "when": { "type": "string" },
        "agent": { "type": "string" },
        "model": { "type": "string" },
        "prompt": { "type": "string" },
        "bash": { "type": "string" },
        "command": { "type": "string" },
        "context": { "type": "string", "enum": ["fresh", "inherit"] },
        "output_format": { "type": "object" },
        "trigger_rule": { "type": "string", "enum": ["all_success", "one_success"] },
        "allowed_tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "loop": {
          "type": "object",
          "required": ["prompt", "until"],
          "properties": {
            "prompt": { "type": "string", "minLength": 1 },
            "until": { "type": "string", "minLength": 1 },
            "max_iterations": { "type": "integer", "minimum": 1 },
            "fresh_context": { "type": "boolean" },
            "interactive": { "type": "boolean" },
            "gate_message": { "type": "string" }
          }
        }
      },
      "oneOf": [
        { "required": ["prompt"] },
        { "required": ["bash"] },
        { "required": ["loop"] },
        { "required": ["command"] }
      ]
    }
  }
}
